{
  "model": {
    "network_class": "FullyConnectedNet",
    "n_hidden_layers": 10,
    "hidden_size": null,
    "norm": "layernorm",
    "dropout": 0.0,
    "init_method": "uniform",
    "weight_init_min": -1.0,
    "weight_init_max": 1.0,
    "activation": "tanh",
    "matched_none": false,
    "stem_lift": false,
    "stem_norm": "groupnorm",
    "init_classifier": "kaiming"
  },
  "lateral_inhibition": {
    "mechanism": "ca",
    "rule": "B3678/S34678",
    "gamma": 15.0,
    "delta": 0.5,
    "normalize_gates": true,
    "require_rescaling": true,
    "require_zero_centring": true,
    "channel_reduce": "mean",
    "channel_reduce_stage": "gates",
    "num_groups": null,
    "neighbourhood_radius": 1
  },
  "optimizer": {
    "type": "adam",
    "lr": 0.001,
    "weight_decay": 0.0005
  },
  "training": {
    "num_epochs": 10,
    "batch_size": 512,
    "seed": 42,
    "lr_schedule": "cosine",
    "max_norm": 5.0,
    "num_workers": 2,
    "device": "cuda",
    "val_frac": 0.1,
    "split_seed": 42
  },
  "augmentation": {
    "augmix_severity": 0,
    "augmix_width": 3,
    "augmix_alpha": 1.0
  },
  "evaluation": {
    "eval_mca": false,
    "mca_corruptions": "noise",
    "mca_n_samples": 2000
  },
  "data": {
    "data_name": "MNIST",
    "data_path": "./data",
    "data_norms": [
      [
        0.5
      ],
      [
        0.5
      ]
    ]
  },
  "logging": {
    "output_path": "paper_runs/rule_sweep/B3678S34678"
  }
}