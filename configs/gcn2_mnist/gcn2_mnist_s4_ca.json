{
  "model": {
    "network_class": "GraphGCN",
    "norm": "none",
    "init_method": "kaiming_tanh",
    "weight_init_min": -1.0,
    "weight_init_max": 1.0,
    "n_hidden_layers": 2,
    "hidden_channels": 16,
    "activation": "tanh",
    "matched_none": false,
    "init_classifier": "kaiming"
  },
  "lateral_inhibition": {
    "mechanism": "ca",
    "rule": "B5/S3",
    "gamma": 15.0,
    "delta": 0.5,
    "normalize_gates": true,
    "require_zero_centring": true,
    "channel_reduce": "mean",
    "channel_reduce_stage": "gates",
    "neighbourhood_radius": 1
  },
  "optimizer": {
    "type": "adam",
    "lr": 0.001,
    "weight_decay": 0.0
  },
  "training": {
    "num_epochs": 200,
    "batch_size": 256,
    "seed": 4,
    "lr_schedule": "constant",
    "max_norm": 5.0,
    "num_workers": 4,
    "device": "cuda",
    "val_frac": 0.1,
    "split_seed": 42
  },
  "augmentation": {
    "augmix_severity": 0,
    "augmix_width": 3,
    "augmix_alpha": 1.0
  },
  "evaluation": {
    "eval_mca": true,
    "mca_corruptions": "noise",
    "mca_n_samples": 2000
  },
  "data": {
    "data_name": "MNIST",
    "data_path": "./data",
    "data_norms": [
      [
        0.5
      ],
      [
        0.5
      ]
    ]
  },
  "logging": {
    "output_path": "paper_runs/gcn2_mnist/s4"
  }
}